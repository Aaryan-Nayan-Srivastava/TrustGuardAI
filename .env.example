# Comma-separated browser origins permitted to call the API. These defaults are
# development frontend origins; set this explicitly for every deployed frontend.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# INFO, WARNING, ERROR, or DEBUG
LOG_LEVEL=INFO

# Optional absolute path to the trusted local model artifact directory.
# TRUSTGUARD_MODEL_DIR=C:\path\to\TrustGuardAI-main\models
